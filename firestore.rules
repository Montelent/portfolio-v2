rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in Firebase account is not automatically a portfolio administrator.
    // Set the custom claim with the Firebase Admin SDK (see docs/ADMIN_SECURITY.md).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Portfolio content is public; mutations are restricted to trusted admins.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/siteConfig {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny access to all collections not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
