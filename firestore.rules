rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins are explicitly allowlisted by the project owner in admins/{uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // A signed-in user may read only their own record to verify admin access.
    // Admin records cannot be managed from the public client.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Portfolio content is public; mutations are restricted to allowlisted admins.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/siteConfig {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny access to all collections not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
